#!/usr/bin/env python3
"""tests/fixtures/orca — 记录 argv 的假 orca，模拟 2026-11-13 决策记录里的编排契约。

行为由环境变量控制：
- FAKE_ORCA_LOG        argv 追加记录文件（JSON Lines），必设
- FAKE_ORCA_REPO_ROOT  repo list 返回的已注册仓库路径
- FAKE_ORCA_WT         worker-start 回执里的 worktreePath
- FAKE_ORCA_EVENT      orchestration check 命中时输出的 JSON 文件；未设则返回空批次（超时）
- FAKE_ORCA_DEAD_TERMINAL  terminal show 对指定 handle 返回失败（测失效句柄）
- FAKE_ORCA_WORKER_TERMINAL  worker-list 里返回一个 live dispatch，其 terminal 为该值（测 worker 身份）
"""

import json
import os
import sys


def out(data: dict) -> None:
    print(json.dumps({"ok": True, "result": data}, ensure_ascii=False))


def main() -> int:
    argv = sys.argv[1:]
    log = os.environ.get("FAKE_ORCA_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(argv, ensure_ascii=False) + "\n")

    def has(flag: str) -> bool:
        return flag in argv

    if argv[0] == "terminal" and argv[1:2] == ["show"]:
        handle = next((argv[i + 1] for i, a in enumerate(argv) if a == "--terminal"), "")
        if handle and handle == os.environ.get("FAKE_ORCA_DEAD_TERMINAL"):
            print(json.dumps({"ok": False, "error": {"code": "terminal_not_found"}}))
            return 1
        out({"terminal": {"handle": handle, "connected": True}})
        return 0

    if argv[0] == "orchestration":
        cmd = argv[1]
        if cmd == "run-current":
            out({"runId": "run-1"})
            return 0
        if cmd == "task-create":
            out({"id": "ot-1", "title": next(argv[i + 1] for i, a in enumerate(argv) if a == "--task-title")})
            return 0
        if cmd == "worker-start":
            wt = os.environ.get("FAKE_ORCA_WT", "/tmp/fake-orca-wt")
            out({"dispatchId": "d-77",
                 "workspace": f"repo-1::{wt}",
                 "branch": "foreman/T-001-impl"})
            return 0
        if cmd == "worker-list":
            term = os.environ.get("FAKE_ORCA_WORKER_TERMINAL")
            workers = [{"dispatchId": "ctx-1", "terminal": term, "liveness": "live",
                        "state": "running"}] if term else []
            out({"workers": workers})
            return 0
        if cmd == "send":
            out({"id": "m-1", "to": argv[argv.index("--to") + 1]})
            return 0
        if cmd == "check":
            ev_file = os.environ.get("FAKE_ORCA_EVENT")
            if ev_file:
                msg = json.load(open(ev_file, encoding="utf-8"))
                out({"messages": msg if isinstance(msg, list) else [msg]})
            else:
                out({"messages": []})
            return 0
        if cmd == "task-update":
            out({"id": argv[argv.index("--id") + 1], "status": argv[argv.index("--status") + 1]})
            return 0
        if cmd == "gate-create":
            out({"id": "gate-1"})
            return 0
        if cmd == "gate-resolve":
            out({"resolved": True})
            return 0
        out({"error": f"unknown orchestration cmd {cmd}"})
        return 1

    if argv[0] == "repo" and argv[1] == "list":
        out({"repos": [{"id": "repo-1", "path": os.environ.get("FAKE_ORCA_REPO_ROOT", "/tmp")}]})
        return 0

    if argv[0] == "worktree" and argv[1] == "rm":
        out({"removed": True})
        return 0

    if argv[0] == "worktree" and argv[1] == "current":
        out({"id": "repo-1::/tmp"})
        return 0

    out({"error": f"fake orca: unknown argv {argv}"})
    return 1


if __name__ == "__main__":
    sys.exit(main())
